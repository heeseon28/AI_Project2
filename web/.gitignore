# 의존성 (package-lock.json은 공유)
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# 테스트 결과
/coverage
/playwright-report/
/test-results/

# Next.js 빌드 결과
/.next/
/out/

# 프로덕션 빌드 결과
/build

# 로컬 인증서
*.pem

# 패키지 관리자 디버그 로그
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# Vercel 로컬 연결 정보
.vercel

# TypeScript 자동 생성 파일
*.tsbuildinfo
next-env.d.ts
